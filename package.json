{
  "name": "@local/dsh-ide",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Main plugin of the dsh-code-editor repository: a VS Code style IDE for DeepSeek Harness with an explorer tree, file tabs, quick open (Ctrl+P), a Monaco editor with AI inline suggestions and a settings drawer for the completion model and API key. It lives in the right sidebar and opens from the IDE button on the Start tab, in the composer row, or in the file/Files tab actions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmixdev/dsh-code-editor.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ide",
    "monaco",
    "code-editor",
    "inline-completion"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "state.js",
    "catalog.js",
    "completion.js",
    "tab.js",
    "edits.js",
    "prefs.js",
    "tree.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "vendor",
    "tests",
    "scripts"
  ],
  "scripts": {
    "check": "node scripts/check-manifests.mjs",
    "test": "node --test tests/host.test.mjs tests/client.test.mjs tests/tab.test.mjs tests/edits.test.mjs",
    "test:editor": "node --test editor/tests/completion.test.mjs editor/tests/client-smoke.test.mjs editor/tests/host-smoke.mjs editor/tests/editor-state.test.mjs editor/tests/sync.test.mjs",
    "test:all": "npm test && npm run test:editor"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
