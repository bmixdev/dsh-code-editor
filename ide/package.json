{
  "name": "@local/dsh-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IDE-like plugin for DeepSeek Harness: VS Code style explorer, tabs and Monaco editor inside the right sidebar.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "state.js",
    "catalog.js",
    "completion.js",
    "prefs.js",
    "tree.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "vendor",
    "tests"
  ],
  "scripts": {
    "test": "node --test tests/host.test.mjs tests/client.test.mjs tests/sync.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
